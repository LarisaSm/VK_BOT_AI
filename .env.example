# Скопируйте этот файл в .env и заполните значения

# --- ВКонтакте: ключ доступа сообщества ---
VK_BOT_TOKEN=

# --- Выбор AI: stub | openai | gigachat ---
# stub — заглушка без AI (для проверки бота)
AI_PROVIDER=stub
AI_SYSTEM_PROMPT=Ты дружелюбный помощник сообщества ВКонтакте. Отвечай кратко и по-русски.
AI_HISTORY_SIZE=10
AI_TIMEOUT=60

# --- AI_PROVIDER=openai: любой OpenAI-совместимый API ---
# Локальная модель Ollama:   AI_BASE_URL=http://localhost:11434/v1  (ключ не нужен)
# Локальная LM Studio:       AI_BASE_URL=http://localhost:1234/v1   (ключ не нужен)
# OpenRouter:                AI_BASE_URL=https://openrouter.ai/api/v1
# Groq:                      AI_BASE_URL=https://api.groq.com/openai/v1
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=
# Для «думающих» моделей (qwen3 и др.): none — отвечать сразу, без размышлений
AI_REASONING_EFFORT=none

# --- AI_PROVIDER=gigachat ---
# Ключ авторизации из https://developers.sber.ru/studio
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к сертификату Минцифры (russian_trusted_root_ca.cer) или GIGACHAT_VERIFY_SSL=false
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true
